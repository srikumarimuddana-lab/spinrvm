# =============================================================================
# Spinr Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is gitignored by design.
#
# For Railway (production/staging): paste these into the Railway dashboard
#   Project → Service → Variables
# For local dev: create backend/.env with real SaaS credentials
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase  (https://supabase.com/dashboard → project → Settings → API)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Security — required; app refuses to start if unset
# JWT_SECRET must be ≥ 32 random characters.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-32-plus-char-random-hex-string

# -----------------------------------------------------------------------------
# Admin credentials — required; app refuses to start if unset
# ADMIN_EMAIL must NOT be admin@spinr.ca or admin@example.com in production.
# ADMIN_PASSWORD must be ≥ 20 characters in production.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=your-admin@yourdomain.com
ADMIN_PASSWORD=YourStrongAdminPassword-min20chars!

# -----------------------------------------------------------------------------
# Environment
# Values: development | staging | production
# Production enforces strong secrets, rejects wildcard CORS, and enables Sentry.
# -----------------------------------------------------------------------------
ENV=development

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# Always includes http://localhost:3000 and https://spinr-admin.vercel.app.
# Add your Railway/Vercel/custom URLs here.
# Example production value:
#   ALLOWED_ORIGINS=https://spinr-admin.vercel.app,https://admin.spinr.ca
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# -----------------------------------------------------------------------------
# Redis — optional in dev (falls back to in-process dict, state lost on restart)
# Recommended: Upstash Redis (https://console.upstash.com) — free tier is fine
# for dev; use a paid tier for production.
# All three can share the same URL or be split across separate databases.
# -----------------------------------------------------------------------------
REDIS_URL=redis://default:your-token@your-upstash-endpoint.upstash.io:6379
RATE_LIMIT_REDIS_URL=
WS_REDIS_URL=

# -----------------------------------------------------------------------------
# Firebase — required for push notifications (FCM) and App Check
# FIREBASE_SERVICE_ACCOUNT_JSON: stringify the downloaded service-account JSON.
#   Mac/Linux: cat serviceAccount.json | tr -d '\n'
# App IDs: Firebase console → Project settings → Your apps
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
FIREBASE_RIDER_APP_ID=1:000000000000:android:your-rider-app-id
FIREBASE_DRIVER_APP_ID=1:000000000000:android:your-driver-app-id

# -----------------------------------------------------------------------------
# Sentry — optional; error tracking (https://sentry.io)
# Leave blank in local dev; set in Railway/Vercel for staging and production.
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Twilio — SMS / OTP delivery (https://console.twilio.com)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# -----------------------------------------------------------------------------
# Stripe — payments (https://dashboard.stripe.com → Developers → API keys)
# Use test keys (pk_test_ / sk_test_) for development and staging.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# -----------------------------------------------------------------------------
# Google Maps — fare estimates and geocoding
# (https://console.cloud.google.com → APIs & Services → Credentials)
# Enable: Maps JavaScript API, Geocoding API, Directions API, Distance Matrix API
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIza...your-server-side-maps-key
