{
  "uid": "spinr-server-metrics",
  "title": "Server metrics (Fly CPU/memory/disk/network)",
  "description": "Real machine-level resource usage for $app, sourced from Fly.io's own hosted Prometheus endpoint (https://api.fly.io/prometheus/spinr_backend/) -- no exporter runs on the app itself. This is infrastructure metrics (CPU/mem/disk/network), NOT the app's own custom counters (dispatch latency, fare calc, etc.) -- those are separate, in Grafana Cloud, gated behind GRAFANA_CLOUD_METRICS_READ_TOKEN (unset as of 2026-09-25; see metrics-agent/README.md).",
  "tags": ["spinr", "backend", "infra"],
  "timezone": "America/Regina",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"] },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "label": "App",
        "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
        "query": "label_values(app)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "current": { "text": "spinr-backend-yyz", "value": "spinr-backend-yyz" }
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Machine",
        "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
        "query": "label_values(fly_instance_cpu{app=\"$app\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview -- average over the selected time range",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg CPU used",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "avg(100 * (1 - (sum by (instance) (rate(fly_instance_cpu{app=\"$app\", instance=~\"$instance\", mode=\"idle\"}[$__range])) / sum by (instance) (rate(fly_instance_cpu{app=\"$app\", instance=~\"$instance\"}[$__range])))))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg memory used",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "avg(100 * (1 - (fly_instance_memory_mem_available{app=\"$app\", instance=~\"$instance\"} / fly_instance_memory_mem_total{app=\"$app\", instance=~\"$instance\"})))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg disk used (root)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "avg(100 * (1 - (fly_instance_filesystem_blocks_avail{app=\"$app\", instance=~\"$instance\"} / fly_instance_filesystem_blocks{app=\"$app\", instance=~\"$instance\"})))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg load (1m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 4 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "avg(fly_instance_load_average{app=\"$app\", instance=~\"$instance\", minutes=\"1\"})",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "CPU",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU used % by machine",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "100 * (1 - (sum by (instance) (rate(fly_instance_cpu{app=\"$app\", instance=~\"$instance\", mode=\"idle\"}[$__rate_interval])) / sum by (instance) (rate(fly_instance_cpu{app=\"$app\", instance=~\"$instance\"}[$__rate_interval]))))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory used % by machine",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "100 * (1 - (fly_instance_memory_mem_available{app=\"$app\", instance=~\"$instance\"} / fly_instance_memory_mem_total{app=\"$app\", instance=~\"$instance\"}))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Disk",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Disk used % by machine (root filesystem)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "100 * (1 - (fly_instance_filesystem_blocks_avail{app=\"$app\", instance=~\"$instance\", mount=\"/.fly-upper-layer\"} / fly_instance_filesystem_blocks{app=\"$app\", instance=~\"$instance\", mount=\"/.fly-upper-layer\"}))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Network",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Network throughput by machine",
      "description": "Positive = received, negative = sent (mirrored below the axis so in/out are easy to tell apart at a glance).",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "sum by (instance) (rate(fly_instance_net_recv_bytes{app=\"$app\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} recv",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "fly-prometheus" },
          "expr": "-sum by (instance) (rate(fly_instance_net_sent_bytes{app=\"$app\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} sent",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
