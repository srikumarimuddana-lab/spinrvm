# Admin dashboard environment variables
# Copy to .env.local for local development.
# Production values are managed in Vercel project settings.

# Backend API base URL (required in production — build fails without it)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sentry error tracking DSN (optional in dev, required in staging/prod)
# PIPEDA A-PE-P2-5: must use EU ingestion to keep Canadian admin telemetry in EU.
# EU format (required):      https://<key>@o<org_id>.ingest.de.sentry.io/<project_id>
# US format (non-compliant): https://<key>@o<org_id>.ingest.sentry.io/<project_id>
# Get the EU DSN from: Sentry → Settings → Projects → <project> → Client Keys (DSN)
# (only visible after migrating the org to EU — contact Sentry support or create a new EU org)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry server-side DSN (same project, server key — required in prod)
# Must also point to the EU ingestion endpoint (same host, different secret key).
SENTRY_DSN=

# Sentry auth token for source-map uploads (CI only, never client-side)
SENTRY_AUTH_TOKEN=

# Injected automatically by Vercel — used for Sentry release tracking
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_SHA=
