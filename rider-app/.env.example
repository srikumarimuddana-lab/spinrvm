# Google Maps - Required for search, maps, directions
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Backend URL (auto-detected in dev via Expo, set for production)
# EXPO_PUBLIC_BACKEND_URL=http://your-backend-url:8000

# Stripe (for payments)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Public tracking URL base — used by "Share Trip" messages so safety
# contacts can open ${BASE}/${share_token} in a browser. The page lives
# in admin-dashboard at /track/[rideId]. Defaults to https://spinr-track.app
# when unset. For local testing, point at the admin-dashboard dev server:
#   EXPO_PUBLIC_TRACK_BASE_URL=http://localhost:3000/track
# For production, point at the deployed admin domain:
#   EXPO_PUBLIC_TRACK_BASE_URL=https://admin.spinr.app/track
