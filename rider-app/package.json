{
  "name": "spinr-rider",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "doctor": "npx --yes expo-doctor",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:web": "expo export --platform web",
    "postinstall": "patch-package && node -e \"const fs=require('fs'),path=require('path');const p=path.join(__dirname,'node_modules','@types','react','package.json');if(fs.existsSync(p)){const pkg=JSON.parse(fs.readFileSync(p,'utf8'));pkg.main='index.d.ts';fs.writeFileSync(p,JSON.stringify(pkg,null,2))}\""
  },
