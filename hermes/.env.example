# Hermes Agent — Environment Variables
# Copy to .env and fill in real values

# === Core ===
ENV=development
PORT=8585
LOG_LEVEL=info
# Secret for MCP auth + webhook signature verification
HERMES_SECRET=change-me-to-a-random-string

# === Spinr Backend ===
SPINR_BACKEND_URL=https://api-spinr.spinr.ca
# Service-level API key (admin JWT or dedicated hermes key)
SPINR_API_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (empty = no restriction)
TELEGRAM_ALLOWED_USERS=
# Set by Fly.io — used to register the webhook automatically
# e.g. https://hermes-spinr.fly.dev
HERMES_PUBLIC_URL=

# === Zoho Cliq ===
ZOHO_CLIQ_WEBHOOK_TOKEN=
ZOHO_CLIQ_BOT_API_URL=
# OAuth2 for Zoho APIs
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# === Zoho Desk ===
ZOHO_DESK_ORG_ID=
ZOHO_DESK_API_URL=https://desk.zoho.com/api/v1

# === LLM (optional — enables natural language chat) ===
# "anthropic" or "openai" — leave empty to disable
LLM_PROVIDER=
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Shared
LLM_MAX_TOKENS=2048
