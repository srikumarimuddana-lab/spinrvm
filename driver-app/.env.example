# =============================================================================
# Spinr Driver App — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is gitignored by design.
#
# For EAS builds (staging / production):
#   eas secret:create --scope project --name EXPO_PUBLIC_BACKEND_URL --value "https://..."
# For local dev on a physical device: set EXPO_PUBLIC_BACKEND_URL to your
#   Railway backend URL (or ngrok tunnel if running the backend locally).
# =============================================================================

# -----------------------------------------------------------------------------
# Backend URL — REQUIRED
# Physical device / Expo Go: must be a public URL, NOT localhost.
# Options:
#   1. Railway deployment  → https://spinrvm-backend-production.up.railway.app
#   2. ngrok tunnel        → https://abc123.ngrok.io   (run: ngrok http 8000)
#   3. LAN IP (same WiFi)  → http://192.168.x.x:8000
# -----------------------------------------------------------------------------
EXPO_PUBLIC_BACKEND_URL=https://your-railway-backend.up.railway.app

# -----------------------------------------------------------------------------
# Google Maps — required for navigation, route display, pickup ETA
# (https://console.cloud.google.com → APIs & Services → Credentials)
# Enable: Maps SDK for Android, Maps SDK for iOS, Directions API
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...your-maps-api-key

# -----------------------------------------------------------------------------
# Stripe — client-side publishable key only (never the secret key here)
# Used for payout onboarding flow.
# Use pk_test_ keys for development and staging.
# (https://dashboard.stripe.com → Developers → API keys)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
