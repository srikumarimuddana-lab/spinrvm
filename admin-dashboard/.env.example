# Admin dashboard environment variables
# Copy to .env.local for local development.
# Production values are managed in Vercel project settings.

# Backend API base URL (required in production — build fails without it)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sentry error tracking DSN (optional in dev, required in staging/prod)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry server-side DSN (same project, server key — required in prod)
SENTRY_DSN=

# Sentry auth token for source-map uploads (CI only, never client-side)
SENTRY_AUTH_TOKEN=

# Injected automatically by Vercel — used for Sentry release tracking
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_SHA=
