          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select round(100.0 * coalesce(sum(connections),0) / current_setting('max_connections')::int, 1) as pct_used from monitoring.connection_summary()"
        }
      ]
    },
