      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(max(oldest_xact_seconds),0) as oldest_xact_seconds from monitoring.connection_summary() where state <> 'idle'"
        }
      ],
      "description": "Age of the longest-running open transaction. Long-open transactions block autovacuum and can hold locks other queries wait on."
    },
    {
      "id": 6,
      "type": "table",
      "title": "Connections by role and state",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase-postgres"
      },
      "description": "'idle in transaction' that persists is a leak signal (a session holding a transaction open while doing nothing).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest_xact_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select role_name, state, connections, oldest_xact_seconds, waiting_on_lock from monitoring.connection_summary() order by connections desc"
        }
      ]
    },
