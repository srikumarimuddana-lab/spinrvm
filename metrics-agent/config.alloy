// Grafana Alloy pipeline for ADR-010's metrics-aggregation MVP (Option B,
// standalone Fly app). See metrics-agent/README.md for the full design.
//
// Pipeline: discovery.file (Fly per-machine targets, refreshed by
// discover-targets.sh every 30s) -> prometheus.scrape (backend's existing
// /metrics endpoint, bearer auth) -> prometheus.remote_write (Grafana
// Cloud).
//
// No changes to backend/utils/metrics.py or /metrics required — this
// consumes the exact Prometheus text-exposition format server.py already
// emits.

discovery.file "backend_targets" {
  files = ["/etc/alloy/targets.json"]
  // Matches discover-targets.sh's refresh cadence so a machine that scales
  // down doesn't get scraped again before the next file refresh.
  refresh_interval = "30s"
}

// prometheus.scrape has no "extra_labels" attribute (that's not part of its
// config schema — confirmed by a real `fly deploy`, 2026-09-05: Alloy
// rejected it with "unrecognized attribute name \"extra_labels\"" and never
// started). A relabel rule with no source_labels and just a replacement is
// the standard Prometheus/Alloy idiom for stamping a constant label onto
// every target before it's scraped.
discovery.relabel "backend_targets" {
  targets = discovery.file.backend_targets.targets

  rule {
    target_label = "provider"
    replacement  = "fly"
  }
}

prometheus.scrape "backend" {
  targets    = discovery.relabel.backend_targets.output
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Matches ADR-010 §5 step 2 (15s scrape interval).
  scrape_interval = "15s"
  scrape_timeout  = "10s"

  // Backend's own convention: bearer token from METRICS_AUTH_TOKEN,
  // "Authorization: Bearer <token>" (backend/server.py's _metrics_token()).
  // Sourced from a Fly secret on THIS app (metrics-agent), which must be
  // set to the same value as the backend app's METRICS_AUTH_TOKEN secret —
  // they are two independent Fly secrets that must be kept in sync by
  // whoever rotates either one.
  bearer_token = env("METRICS_AUTH_TOKEN")

  // metric_path defaults to "/metrics", matching backend/server.py's route.
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    // Placeholder — set via the GRAFANA_REMOTE_WRITE_URL Fly secret. Not a
    // real endpoint; see README.md "What's blocked" section for the
    // `fly secrets set` command a human runs post-account-creation.
    url = env("GRAFANA_REMOTE_WRITE_URL")

    basic_auth {
      username = env("GRAFANA_REMOTE_WRITE_USERNAME")
      password = env("GRAFANA_REMOTE_WRITE_API_KEY")
    }
  }
}
