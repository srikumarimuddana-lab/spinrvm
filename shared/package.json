{
  "name": "@spinr/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared code used across Spinr rider-app, driver-app, and admin-dashboard",
  "sideEffects": false,
  "exports": {
    "./api": "./api/client.ts",
    "./api/client": "./api/client.ts",
    "./api/cachedClient": "./api/cachedClient.ts",
    "./api/upload": "./api/upload.ts",
    "./api/queryClient": "./api/queryClient.ts",
    "./hooks/queries": "./hooks/queries/index.ts",
    "./validators": "./validators/index.ts",
    "./config": "./config/index.ts",
    "./config/spinr.config": "./config/spinr.config.ts",
    "./config/firebaseConfig": "./config/firebaseConfig.ts",
    "./store/authStore": "./store/authStore.ts",
    "./store/locationStore": "./store/locationStore.ts",
    "./services/firebase": "./services/firebase.ts",
    "./utils/logger": "./utils/logger.ts",
    "./utils/pii": "./utils/pii.ts",
    "./utils/responsive": "./utils/responsive.ts",
    "./cache": "./cache/index.ts",
    "./types": "./types/index.ts",
    "./types/*": "./types/*.ts",
    "./components/*": "./components/*"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": ">=11.0.0",
    "expo-image": ">=55.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "typescript": "~5.9.2"
  }
}
