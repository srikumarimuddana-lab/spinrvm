    {
      "id": 16,
      "type": "table",
      "title": "Largest tables",
      "description": "dead_pct is dead tuples as a share of live+dead -- a bloat / autovacuum-lag signal. High seq_scan relative to idx_scan on a large table often means a missing index.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total_size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dead_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select s.schemaname || '.' || s.relname as table_name, pg_total_relation_size(s.relid) as total_size, s.n_live_tup as est_rows, s.n_dead_tup as dead_rows, round(100.0 * s.n_dead_tup / nullif(s.n_live_tup + s.n_dead_tup, 0), 1) as dead_pct, s.seq_scan, s.idx_scan, greatest(s.last_autovacuum, s.last_vacuum) as last_vacuum from pg_stat_user_tables s order by pg_total_relation_size(s.relid) desc limit 15"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Database errors -- as seen by the backend (from Loki, 7-day history)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "DB errors + warnings (selected range)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "loki",
        "uid": "fly-logs-loki"
      },
      "description": "Backend log lines at WARNING/ERROR/CRITICAL that mention Supabase, PostgREST (PGRST codes / APIError), 'Database operation failed', or HTTP/2 GOAWAY. This is what our app experienced -- Supabase's own internal logs stay in its dashboard Log Explorer (a log drain was deliberately not added: $60/month).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "fly-logs-loki"
          },
          "expr": "sum(count_over_time({app=\"spinr-backend-yyz\"} |~ `(?i)\\[DB\\]|supabase|postgrest|PGRST|APIError|database operation failed|DatabaseError|GOAWAY` | json app_level=\"record.level.name\", line_text=\"text\" | drop __error__, __error_details__ | app_level=~\"ERROR|CRITICAL|WARNING\" [$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "DB errors over time",
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
