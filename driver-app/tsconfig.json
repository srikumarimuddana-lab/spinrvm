{
  "extends": "./node_modules/expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      "react-native": [
        "./node_modules/react-native"
      ],
      "react-native-maps": [
        "./node_modules/react-native-maps"
      ],
      "expo-constants": [
        "./node_modules/expo-constants"
      ],
      "expo-image": [
        "./node_modules/expo-image"
      ],
      "expo-blur": [
        "./node_modules/expo-blur"
      ],
      "react-native-reanimated": [
        "./node_modules/react-native-reanimated"
      ],
      "react-native-reanimated/*": [
        "./node_modules/react-native-reanimated/*"
      ],
      "react-native-svg": [
        "./node_modules/react-native-svg"
      ],
      "expo-clipboard": [
        "./node_modules/expo-clipboard"
      ],
      "expo-router": [
        "./node_modules/expo-router"
      ],
      "firebase/*": [
        "./node_modules/firebase/*"
      ],
      "@react-native-community/netinfo": [
        "./node_modules/@react-native-community/netinfo"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "react/jsx-dev-runtime": [
        "./node_modules/@types/react/jsx-dev-runtime"
      ],
      "react-native-safe-area-context": [
        "./node_modules/react-native-safe-area-context"
      ],
      "@expo/vector-icons": [
        "./node_modules/@expo/vector-icons"
      ],
      "@expo/vector-icons/*": [
        "./node_modules/@expo/vector-icons/*"
      ],
      "@react-native-async-storage/async-storage": [
        "./node_modules/@react-native-async-storage/async-storage"
      ],
      "@react-native-firebase/messaging": [
        "./node_modules/@react-native-firebase/messaging"
      ],
      "@react-native-firebase/crashlytics": [
        "./node_modules/@react-native-firebase/crashlytics"
      ],
      "@react-native-firebase/app-check": [
        "./node_modules/@react-native-firebase/app-check"
      ],
      "@tanstack/react-query": [
        "./node_modules/@tanstack/react-query"
      ],
      "@tanstack/query-async-storage-persister": [
        "./node_modules/@tanstack/query-async-storage-persister"
      ],
      "expo-location": [
        "./node_modules/expo-location"
      ],
      "@supabase/supabase-js": [
        "./node_modules/@supabase/supabase-js"
      ],
      "expo-notifications": [
        "./node_modules/expo-notifications"
      ],
      "axios": [
        "./node_modules/axios"
      ],
      "zustand": [
        "./node_modules/zustand"
      ],
      "zustand/middleware": [
        "./node_modules/zustand/middleware"
      ],
      "expo-secure-store": [
        "./node_modules/expo-secure-store"
      ],
      "@components/*": [
        "./components/*"
      ],
      "@hooks/*": [
        "./hooks/*"
      ],
      "@styles/*": [
        "./styles/*"
      ],
      "@types/*": [
        "./types/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../shared/**/*.ts",
    "../shared/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "../shared/api/queryClient.ts",
    "../shared/hooks/queries/driverQueries.ts",
    "../shared/hooks/queries/notificationQueries.ts",
    "../shared/build-types/**",
    "../shared/types/peer-deps.d.ts"
  ]
}
