# `shared` ships TypeScript source and declares react-native / expo-image /
# netinfo / react as peerDependencies — the consuming app provides them
# (rider-app, driver-app and admin-dashboard each install it as `file:../shared`,
# which resolves this package's package.json, never its lockfile).
#
# npm 7+ auto-installs peerDependencies, which pulls the entire React Native
# dev toolchain into this package's lockfile: 513 packages, including
# @babel/core, shell-quote and ws advisories that `shared` does not ship and
# cannot fix. That made the G4b audit gate permanently red against a dependency
# tree no build ever installs, while the real trees are audited in the
# rider-app / driver-app / admin-dashboard legs of the same matrix.
#
# Keeping peers out of the lockfile makes it describe what this package
# actually depends on (3 devDeps). Do not remove this without regenerating the
# lockfile and re-checking G4b.
legacy-peer-deps=true
