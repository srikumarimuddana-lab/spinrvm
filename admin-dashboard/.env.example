# =============================================================================
# Spinr Admin Dashboard — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git — it is gitignored by design.
#
# For Vercel (staging / production): paste these in the Vercel dashboard
#   Project → Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Backend URL (server-side — used by Next.js API proxy in next.config.ts)
# All /api/* and /ws/* requests are rewritten to this URL server-side,
# so the browser never needs to reach the backend directly (no CORS issues).
#
# For local dev: http://127.0.0.1:8000 (backend running locally)
# For Vercel:    https://your-railway-backend.up.railway.app
# -----------------------------------------------------------------------------
BACKEND_URL=https://your-railway-backend.up.railway.app

# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL — leave EMPTY in normal use.
# The admin dashboard routes all API calls through the Next.js proxy (/api/*).
# Only set this if you are intentionally bypassing the proxy for a specific
# deployment scenario and you have configured CORS on the backend accordingly.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Sentry — optional; error tracking for the admin surface
# Leave blank in local dev; set in Vercel for staging and production.
# (https://sentry.io → Project → Settings → Client Keys)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
