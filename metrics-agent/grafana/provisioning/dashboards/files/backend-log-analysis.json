{
  "uid": "spinr-backend-log-analysis",
  "title": "Backend log analysis (errors / warnings / critical)",
  "description": "Severity breakdown of $app's logs. Counts are parsed from the app's own loguru JSON (record.level.name) at query time, NOT from Loki's 'level' label -- that label reflects Fly's stream classification (stdout/stderr) and is 'info' for every line regardless of real severity, since the backend logs everything to stderr via loguru. See metrics-agent/README.md 'Logs & Grafana'.",
  "tags": ["spinr", "backend", "logs"],
  "timezone": "America/Regina",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"] },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "label": "App",
        "datasource": { "type": "loki", "uid": "fly-logs-loki" },
        "query": "label_values(app)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "current": { "text": "spinr-backend-yyz", "value": "spinr-backend-yyz" }
      },
      {
        "name": "level",
        "type": "custom",
        "label": "Severity",
        "query": "All : .*,INFO : INFO,WARNING : WARNING,ERROR : ERROR,CRITICAL : CRITICAL",
        "current": { "text": "All", "value": ".*" },
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview -- counts over the selected time range",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "INFO",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "sum(count_over_time({app=\"$app\"} | json app_level=\"record.level.name\" | app_level=\"INFO\" [$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "WARNING",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "sum(count_over_time({app=\"$app\"} | json app_level=\"record.level.name\" | app_level=\"WARNING\" [$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ERROR",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "sum(count_over_time({app=\"$app\"} | json app_level=\"record.level.name\" | app_level=\"ERROR\" [$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CRITICAL",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "sum(count_over_time({app=\"$app\"} | json app_level=\"record.level.name\" | app_level=\"CRITICAL\" [$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Crash / segfault-style signatures (raw text match, not loguru JSON)",
      "description": "Matches Python fatal-error / segfault / unhandled-traceback patterns printed directly to stderr, outside the app's normal loguru logging (e.g. an interpreter crash before logging is even configured).",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "sum(count_over_time({app=\"$app\"} |~ `(?i)segmentation fault|sigsegv|fatal python error|core dumped` [$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Trend -- log volume by severity over time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Log lines by severity",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "{app_level=\"ERROR\"}" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "{app_level=\"CRITICAL\"}" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } } ] },
          { "matcher": { "id": "byName", "options": "{app_level=\"WARNING\"}" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "{app_level=\"INFO\"}" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "sum by (app_level) (count_over_time({app=\"$app\"} | json app_level=\"record.level.name\" | app_level=~\"INFO|WARNING|ERROR|CRITICAL\" [$__interval]))",
          "legendFormat": "{{app_level}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Drill-down -- exact log lines (filter by $level above)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Raw log lines -- $app / $level",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "{app=\"$app\"} | json app_level=\"record.level.name\", line_text=\"text\" | drop __error__, __error_details__ | app_level=~\"$level\" | line_format \"{{if .line_text}}{{.line_text}}{{else}}{{__line__}}{{end}}\"",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Further analysis -- what actually happened",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Lines with a captured exception/traceback (loguru)",
      "description": "record.exception is populated by loguru whenever the log call captured a real Python exception -- the exact traceback for that failure.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "{app=\"$app\"} | json exc_type=\"record.exception.type\", line_text=\"text\" | exc_type != \"\" | line_format \"{{.line_text}}\"",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Raw crash / segfault signatures (non-loguru)",
      "description": "Fatal interpreter-level crashes printed straight to stderr, outside loguru's JSON -- e.g. a real segfault. Distinct from the panel on the left, which only covers exceptions loguru itself caught and logged.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "loki", "uid": "fly-logs-loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "fly-logs-loki" },
          "expr": "{app=\"$app\"} |~ `(?i)segmentation fault|sigsegv|fatal python error|core dumped`",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
