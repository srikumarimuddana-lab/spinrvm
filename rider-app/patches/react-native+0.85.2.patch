+// PATCH (spinr rider-app/driver-app):
+// RN 0.85.2's Android ActivityIndicator path imports ProgressBarAndroid, whose
+// codegenNativeComponent('AndroidProgressBar', { interfaceOnly: true }) returns
+// a non-renderable object under the New Architecture (Bridgeless), throwing
+// "Element type is invalid... got: object" at render time.
+// JS-only fallback below renders a styled View. Honors `animating`,
+// `hidesWhenStopped`, `color`, and forwards size via the parent's `style`.
+function AndroidActivityIndicatorJSFallback(props: $FlowFixMe): React.Node {
+  const {animating, color, hidesWhenStopped, style, ...rest} = props;
+  if (animating === false && hidesWhenStopped !== false) {
+    return null;
+  }
+  return (
+    <View
+      style={[
+        {
+          borderRadius: 9999,
+          backgroundColor: color != null ? color : '#999999',
+          opacity: animating === false ? 0 : 0.55,
+        },
+        style,
+      ]}
+      {...rest}
+    />
+  );
+}
+
+const PlatformActivityIndicator =
+  Platform.OS === 'android'
+    ? AndroidActivityIndicatorJSFallback
+    : require('./ActivityIndicatorViewNativeComponent').default;

 const GRAY = '#999999';

