{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5",
  "autoCompactEnabled": true,
  "autoCompactWindow": 80000,
  "cleanupPeriodDays": 7,
  "attribution": {
    "commit": "Co-developed with Claude Code (claude-sonnet-5)\n\nCo-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "AI-assisted — spinr platform (Claude Code)"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git pull*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push origin main)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin hotfix/*)",
      "Bash(git push --force-with-lease origin claude/*)",
      "Bash(git push --force-with-lease origin fix/*)",
      "Bash(git push --force-with-lease origin feature/*)",
      "Bash(git push --force-with-lease origin hotfix/*)",
      "Bash(git push --force-with-lease origin HEAD:claude/*)",
      "Bash(git push --force-with-lease origin HEAD:fix/*)",
      "Bash(git push --force-with-lease origin HEAD:feature/*)",
      "Bash(git push --force-with-lease origin HEAD:hotfix/*)",
      "Bash(git push -u origin HEAD:claude/*)",
      "Bash(git push -u origin HEAD:fix/*)",
      "Bash(gh pr*)",
      "Bash(gh issue*)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run type-check)",
      "Bash(npm run test:*)",
      "Bash(npm ci)",
      "Bash(npx expo:*)",
      "Bash(npx expo-doctor:*)",
      "Bash(npm run:*)",
      "Bash(python -m pytest*)",
      "Bash(pip install*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Read(**)",
      "Write(backend/**)",
      "Write(rider-app/**)",
      "Write(driver-app/**)",
      "Write(admin-dashboard/**)",
      "Write(shared/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(scripts/**)",
      "Write(*.md)",
      "Write(CLAUDE.md)",
      "Write(.claude/settings.json)",
      "Write(.claude/commands/**)",
      "Write(.claude/agents/**)",
      "Write(.claude/hooks/**)",
      "Write(.claude/context/**)",
      "Write(.github/workflows/claude.yml)",
      "Write(.github/workflows/claude-audit.yml)",
      "Write(.github/workflows/claude-review.yml)",
      "Write(.github/workflows/pr-checks.yml)",
      "Write(.github/workflows/ci-guardrails.yml)",
      "Write(.github/pull_request_template.md)",
      "Write(.github/labeler.yml)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force origin*)",
      "Bash(git reset --hard*)",
      "Write(.env*)",
      "Write(*.pem)",
      "Write(*.key)",
      "Write(.claude/settings.local.json)",
      "Write(.github/workflows/ci.yml)",
      "Write(.github/workflows/deploy-backend.yml)",
      "Write(.github/workflows/eas-build.yml)",
      "Write(.github/workflows/test-env.yml)",
      "Write(.github/workflows/apply-supabase-schema.yml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -x .git/hooks/pre-commit || (cp .claude/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && echo \"pre-commit hook installed\")'"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "bash -c 'cd backend && python3 -m pip install -q -r requirements.txt 2>/dev/null && echo \"backend deps ok\" || echo \"backend pip install skipped (no venv?)\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'test -d rider-app/node_modules && echo \"rider-app deps ok\" || (cd rider-app && yarn install --frozen-lockfile --silent && echo \"rider-app deps installed\")'"
          },
          {
            "type": "command",
            "command": "bash -c 'test -d driver-app/node_modules && echo \"driver-app deps ok\" || (cd driver-app && yarn install --frozen-lockfile --silent && echo \"driver-app deps installed\")'"
          },
          {
            "type": "command",
            "command": "bash -c 'test -d admin-dashboard/node_modules && echo \"admin deps ok\" || (cd admin-dashboard && npm ci --silent && echo \"admin deps installed\")'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/pre-migration-write.sh" },
          { "type": "command", "command": "bash .claude/hooks/pre-domain-write.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/post-python-write.sh" }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills@2c60614": true
  }
}
