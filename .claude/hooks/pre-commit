#!/bin/bash
# spinr Pre-Commit Security Hook
# Install: cp .claude/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# This is the repo's one canonical pre-commit hook. A parallel Husky-based
# hook (.husky/pre-commit) used to also install to .git/hooks/pre-commit —
# whichever one got copied there last silently won, so gitleaks/ruff/eslint
# and this hook's own checks were never guaranteed to run together (found
# 2026-09-07: core.hooksPath was unset and this file's own SessionStart
# install had won, leaving Husky's hook dormant). Husky's three checks are
# folded in below (steps 1, 7, 8) instead of running two hooks; .husky/
# no longer ships a pre-commit script. .husky/commit-msg is untouched — it
# only runs commitlint and never touched this git-hook slot.

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo ""
echo -e "${BLUE}spinr pre-commit security check...${NC}"
BLOCKED=0

# 1. Gitleaks (entropy + pattern based, if installed)
echo "1/12 Running gitleaks (if installed)..."
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --config .gitleaks.toml --redact; then
    echo -e "${RED}  BLOCKED — gitleaks found a likely secret${NC}"
    BLOCKED=1
  fi
else
  echo -e "${YELLOW}  ⚠ gitleaks not installed — skipping (install: brew install gitleaks). Pattern fallback below still runs.${NC}"
fi

# 2. Secrets (pattern fallback — catches common cases even without gitleaks)
echo "2/12 Scanning for secrets (pattern fallback)..."
PATTERNS=(
  "sk_live_[a-zA-Z0-9]+"
  "pk_live_[a-zA-Z0-9]+"
  "SUPABASE_SERVICE_ROLE_KEY\s*=\s*['\"][^'\"]{20,}"
  "sk-ant-[a-zA-Z0-9\-]+"
  "AIza[0-9A-Za-z\-_]{35}"
  "gh[pousr]_[a-zA-Z0-9]{36}"
  "AKIA[0-9A-Z]{16}"
  "https://hooks\.slack\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/"
  "password\s*[=:]\s*['\"][^'\"]{6,}"
  "DATABASE_URL.*:[^@]+@"
)
# Exclude paths that legitimately contain literal pattern strings as
# meta-documentation about what this scanner detects.
SECRET_SCAN_EXCLUDES=(
  ':!docs/claude-audit*'
  ':!docs/proposed-claude-audit-*'
  ':!.claude/hooks/pre-commit'
)
FOUND=0
for p in "${PATTERNS[@]}"; do
  M=$(git diff --cached -U0 -- "${SECRET_SCAN_EXCLUDES[@]}" | grep "^+" | grep -iE "$p" 2>/dev/null)
  if [ -n "$M" ]; then
    echo -e "${RED}  BLOCKED — secret detected: $p${NC}"
    FOUND=1; BLOCKED=1
  fi
done
[ $FOUND -eq 0 ] && echo -e "${GREEN}  ✅ Clean${NC}"

# 3. Forbidden files
echo "3/12 Checking forbidden files..."
FORBIDDEN=(".env" ".env.local" ".env.production" ".env.staging" "*.pem" "*.key" "serviceAccountKey.json")
FOUND=0
for f in "${FORBIDDEN[@]}"; do
  S=$(git diff --cached --name-only | grep -E "(^|/)${f//\*/[^/]*}$" 2>/dev/null)
  if [ -n "$S" ]; then
    echo -e "${RED}  BLOCKED — forbidden file: $S${NC}"
    FOUND=1; BLOCKED=1
  fi
done
[ $FOUND -eq 0 ] && echo -e "${GREEN}  ✅ Clean${NC}"

# 4. PII in logs
echo "4/12 Checking for PII in logs..."
PII_PATTERNS=(
  "print.*lat.*lng"
  "print.*latitude"
  "print.*phone"
  "console\.log.*lat.*lng"
  "console\.log.*phoneNumber"
  "logger\.(info|debug).*coordinates"
)
FOUND=0
for p in "${PII_PATTERNS[@]}"; do
  M=$(git diff --cached -U0 -- '*.py' '*.ts' '*.tsx' '*.js' | grep "^+" | grep -iE "$p" 2>/dev/null)
  if [ -n "$M" ]; then
    echo -e "${RED}  BLOCKED — PII in log: $p${NC}"
    FOUND=1; BLOCKED=1
  fi
done
[ $FOUND -eq 0 ] && echo -e "${GREEN}  ✅ Clean${NC}"

# 5. Branch protection
echo "5/12 Checking branch..."
BRANCH=$(git branch --show-current)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo -e "${RED}  BLOCKED — direct commits to $BRANCH not allowed${NC}"
  BLOCKED=1
elif [ "$BRANCH" = "develop" ]; then
  echo -e "${YELLOW}  WARNING — committing directly to develop${NC}"
else
  echo -e "${GREEN}  ✅ On feature branch: $BRANCH${NC}"
fi

# 6. Float money check (blocking, scoped to the SR-03 money-file list)
# Was warning-only and scanned every staged *.py/*.ts file. Narrowed and
# made blocking (ROADMAP N3 remainder, MONEY-005) to match CLAUDE.md's
# "Money arithmetic" claim that a pre-commit hook actually blocks this.
# Scope is exactly .semgrep/spinr-rules.yml's spinr-no-float-in-money (SR-03)
# `include` list — the files that rule and its sibling spinr-no-bare-sum-in-
# money already gate in CI, so this hook and that gate never disagree on
# which files are "money files" (tests/hooks/test_money_file_list_parity.py
# asserts this hook's list, SR-03's include and SR-12's include never drift).
# Scoped by parsing diff file headers (like check 12's phone scan below)
# instead of a `git diff -- <pathspec>`, so it also works correctly in front
# of tests/hooks/test_pre_commit.sh's fake git shim, which returns the whole
# patch for any `--cached -U0` call regardless of the pathspec passed.
# `--src-prefix=a/ --dst-prefix=b/` pins the `+++ b/<path>` header shape this
# awk program parses, overriding a user's diff.mnemonicPrefix/diff.noprefix
# git config (which would otherwise rewrite the prefix to something like
# `i/`/`w/` or drop it, breaking the `sub(/^b\//, ...)` strip below).
#
# False-positive handling (review finding, 2026-09-26): a naive "skip only
# full-comment lines" check blocked on a trailing/inline comment
# (`x = 1  # fare+0.01 tolerance`) and on a float-shaped tolerance string
# inside a docstring. Fixed by, per added line: (1) stripping a trailing
# `#...` comment via a char-by-char scan that ignores `#` while inside a
# '...'/"..." string (does not handle backslash-escaped quotes — a known,
# accepted simplification); (2) tracking `"""`/`'''` open/close state across
# the added lines of each file and skipping any line that is inside, opens,
# or closes a triple-quoted region; (3) skipping a line whose only content
# (after the comment strip) is itself a single string literal. Because the
# diff is -U0, only added lines are visible, so the triple-quote tracker has
# no view of unchanged lines — a hunk that starts partway through an
# existing docstring, or whose matching `"""`/`'''` close is on an unchanged
# line, can leave the tracker's state wrong for the rest of that file's
# hunks in this diff. This is a known, accepted limitation: the tracker is
# deliberately conservative (any line it's unsure about is skipped, never
# blocked), so the failure mode is a missed real violation, never a false
# block — the same trade-off CI's SR-03/SR-11/SR-12 semgrep gate exists to catch
# with real AST parsing. Verified against every line of every file in the
# list below as a synthetic full-file addition (2026-09-25, re-verified
# 2026-09-26 after this fix): 0 hits. See tests/hooks/test_pre_commit.sh
# Gate 5 for the inline-comment / docstring / comment-plus-real-float cases.
echo "6/12 Checking money arithmetic (blocking, scoped to money files)..."
# shellcheck disable=SC2016  # awk program, $-fields are awk's, not the shell's
MONEY_FLOAT_AWK='
BEGIN {
  n = split("backend/routes/fares.py backend/routes/payments.py backend/routes/wallet.py backend/routes/rides/payments.py backend/services/fare_service.py backend/services/payment_service.py backend/services/corporate_wallet_service.py backend/services/corporate_allowance_service.py backend/services/corporate_subscription_service.py backend/utils/stripe_charge.py backend/utils/receipt_pdf.py backend/utils/email_receipt.py backend/routes/drivers/earnings.py backend/features.py backend/utils/referral_payout.py", files, " ")
  for (i = 1; i <= n; i++) money[files[i]] = 1
  file = ""; hdr = 0; in_money = 0; intriple = 0
  # Built via sprintf(), not a literal '"'"' character, so this awk source
  # never contains a single quote — it has to stay embeddable inside this
  # variable'"'"'s own shell single-quotes.
  sq = sprintf("%c", 39)
  dq3 = "\"\"\""
  sq3 = sq sq sq
  dq_line_re = "^\"[^\"]*\"[,)]?[ \t]*$"
  sq_line_re = "^" sq "[^" sq "]*" sq "[,)]?[ \t]*$"
}
# Returns the prefix of s up to (not including) the first "#" that is not
# inside a '"'"'...'"'"'/"..." string. Simple quote-depth scan — does not
# handle a backslash-escaped quote inside the string, by design (documented
# limitation above).
function strip_comment(s,    i, c, inq, qc) {
  inq = 0; qc = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (inq) {
      if (c == qc) inq = 0
    } else {
      if (c == "\"" || c == sq) { inq = 1; qc = c }
      else if (c == "#") return substr(s, 1, i - 1)
    }
  }
  return s
}
/^diff --git / { hdr = 1; next }
hdr && /^\+\+\+ / {
  file = substr($0, 5); sub(/^b\//, "", file)
  in_money = (file in money)
  intriple = 0
  next
}
/^@@ / { hdr = 0; next }
hdr { next }
/^-/ { next }
/^\+/ {
  if (in_money) {
    line = substr($0, 2)
    stripped = line
    sub(/^[ \t]+/, "", stripped)
    is_full_comment = (stripped ~ /^#/)
    was_intriple = intriple
    ntrip = 0
    if (was_intriple || !is_full_comment) {
      tmp = stripped
      ntrip = gsub(dq3, "@", tmp)
      tmp = stripped
      ntrip += gsub(sq3, "@", tmp)
    }
    if (ntrip % 2 == 1) intriple = 1 - was_intriple
    if (was_intriple || ntrip > 0 || is_full_comment) { next }
    code = strip_comment(stripped)
    sub(/[ \t]+$/, "", code)
    if (code == "" || code ~ dq_line_re || code ~ sq_line_re) { next }
    if (tolower(code) ~ /(fare|price|amount|earning|payout)[ \t]*[+\-*\/][ \t]*[0-9]*\.[0-9]+/) {
      printf "%s: %s\n", file, line
    }
  }
  next
}
'
# Fail closed: this check now blocks, so a diff/awk failure must not read as
# "no float arithmetic found" (same rationale as check 12 below).
MONEY_SCAN_OK=1
MONEY_DIFF=$(git diff --cached -U0 --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/) || MONEY_SCAN_OK=0
MONEY_HITS=$(printf '%s\n' "$MONEY_DIFF" | awk "$MONEY_FLOAT_AWK") || MONEY_SCAN_OK=0
if [ "$MONEY_SCAN_OK" -eq 0 ]; then
  echo -e "${RED}  BLOCKED — money arithmetic scan could not run (git diff or awk failed)${NC}"
  BLOCKED=1
elif [ -n "$MONEY_HITS" ]; then
  while IFS= read -r hit; do
    echo -e "${RED}  BLOCKED — float money arithmetic: $hit${NC}"
  done <<< "$MONEY_HITS"
  echo -e "${RED}  Use Decimal (_d()/_round()/_f()) instead of float arithmetic. See CLAUDE.md \"Money arithmetic\".${NC}"
  BLOCKED=1
else
  echo -e "${GREEN}  ✅ Clean${NC}"
fi

# 7. Python lint (staged backend/*.py — folded in from .husky/pre-commit)
echo "7/12 Running ruff (staged backend/*.py)..."
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.py$' || true)
if [ -n "$STAGED_PY" ]; then
  if command -v ruff >/dev/null 2>&1; then
    mapfile -t PY_FILES <<< "$STAGED_PY"
    if ! ruff check "${PY_FILES[@]}" || ! ruff format --check "${PY_FILES[@]}"; then
      echo -e "${RED}  BLOCKED — ruff check/format failed${NC}"
      BLOCKED=1
    else
      echo -e "${GREEN}  ✅ Clean${NC}"
    fi
  else
    echo -e "${YELLOW}  ⚠ ruff not installed — skipping (pip install ruff). CI still gates on this.${NC}"
  fi
else
  echo -e "${GREEN}  ✅ No staged backend/*.py${NC}"
fi

# 8. TypeScript lint (staged admin-dashboard/src — folded in from .husky/pre-commit)
echo "8/12 Running eslint (staged admin-dashboard/src)..."
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep '^admin-dashboard/src/.*\.\(ts\|tsx\)$' || true)
if [ -n "$STAGED_TS" ]; then
  # shellcheck disable=SC2001  # per-line ^-anchored strip; a bash-native
  # ${var//pattern/repl} replace-all has no per-line anchor and could strip
  # a mid-path match too — sed's line-by-line ^ is the correct semantics here.
  TS_FILES=$(echo "$STAGED_TS" | sed 's|^admin-dashboard/||')
  mapfile -t TS_FILE_ARR <<< "$TS_FILES"
  if (cd admin-dashboard && npx --no-install eslint "${TS_FILE_ARR[@]}"); then
    echo -e "${GREEN}  ✅ Clean${NC}"
  else
    echo -e "${RED}  BLOCKED — eslint failed${NC}"
    BLOCKED=1
  fi
else
  echo -e "${GREEN}  ✅ No staged admin-dashboard/src/*.ts(x)${NC}"
fi

# 9. Doc-cited file path drift (CLAUDE.md + .claude/context/*.md)
# Warning-only: reports backtick-quoted paths that look like repo files/dirs
# but don't exist on disk. Never blocks a commit while in this mode.
# TODO(2026-09-01): flip to blocking (exit 1) once the warning backlog is clear.
echo "9/12 Checking doc-cited file paths (warning only)..."
DOC_PATH_TMP=$(mktemp 2>/dev/null)
check_doc_paths() {
  set -e
  local repo_root doc rel_doc token path top doc_files out="$1"
  repo_root=$(git rev-parse --show-toplevel)
  doc_files=$(
    printf '%s\n' "$repo_root/CLAUDE.md"
    find "$repo_root/.claude/context" -maxdepth 1 -name '*.md' \
      -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null
  )
  while IFS= read -r doc; do
    [ -f "$doc" ] || continue
    rel_doc=${doc#"$repo_root"/}
    while IFS= read -r token; do
      [ -z "$token" ] && continue
      path="${token#\`}"
      path="${path%\`}"
      top="${path%%/*}"
      # Only check tokens whose first segment is a real top-level repo
      # entry — skips partial/shorthand refs (e.g. `routes/rides.py`
      # written without a `backend/` prefix) and template placeholders
      # (e.g. `<app>/__tests__/`), which are expected false positives.
      [ -e "$repo_root/$top" ] || continue
      if [ ! -e "$repo_root/$path" ]; then
        echo "$rel_doc cites missing path: $path" >> "$out"
      fi
    done < <(
      # shellcheck disable=SC2016  # backticks below are literal Markdown code-span delimiters, not command substitution
      grep -ohE '`[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+/?`' "$doc" 2>/dev/null \
      | grep -E '\.(py|ts|tsx|sql|md|sh|json)`$|/`$' || true)
  done <<< "$doc_files"
}
if [ -n "$DOC_PATH_TMP" ] && (check_doc_paths "$DOC_PATH_TMP"); then
  if [ -s "$DOC_PATH_TMP" ]; then
    while IFS= read -r line; do
      echo -e "${YELLOW}  WARN — $line${NC}"
    done < "$DOC_PATH_TMP"
    echo -e "${YELLOW}  (warning-only — not blocking commit; see TODO above)${NC}"
  else
    echo -e "${GREEN}  ✅ Clean${NC}"
  fi
else
  echo -e "${YELLOW}  ⚠️  doc-path check errored unexpectedly — skipping (warning mode)${NC}"
fi
rm -f "$DOC_PATH_TMP"

# 10. Shared-component Change Impact Log reminder (warning only)
# CLAUDE.md's pre-merge gate #3 requires a Change Impact Log entry (+ usually
# a feature flag) for any change to a shared component used by 3+ pages. A
# pre-commit hook can't see the eventual PR body (that's what
# ci-guardrails.yml's own Change Impact Log check verifies), so this can only
# nudge: flag a staged file that looks shared and hasn't been paired with a
# new docs/change-log/ entry in the same commit, never block on it.
echo "10/12 Checking shared-component Change Impact Log reminder (warning only)..."
SHARED_DIRS='^(admin-dashboard/src/components/|rider-app/components/|driver-app/components/|shared/)'
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
STAGED_SHARED=$(printf '%s\n' "$STAGED_FILES" | grep -E "$SHARED_DIRS" | grep -viE '__tests__|\.(test|spec)\.' 2>/dev/null)
HAS_CHANGE_LOG=$(printf '%s\n' "$STAGED_FILES" | grep -c '^docs/change-log/' 2>/dev/null)
FOUND=0
if [ -n "$STAGED_SHARED" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    base=$(basename "$f")
    base="${base%.*}"
    # Count distinct OTHER files in the repo that reference this component's
    # basename (import/require by name) — a rough, fast proxy for "how many
    # pages use this," not a real import-graph resolution. False positives
    # (a common name matching unrelated text) are expected and fine for a
    # warning-only nudge.
    REFS=$(git grep -l -w "$base" -- '*.ts' '*.tsx' '*.js' '*.jsx' ':!node_modules' ':!.next' ':!dist' ':!build' 2>/dev/null | grep -vFc "$f")
    if [ "$REFS" -ge 3 ]; then
      if [ "$HAS_CHANGE_LOG" -eq 0 ]; then
        echo -e "${YELLOW}  WARN — $f looks shared (referenced by ~$REFS other files) — CLAUDE.md gate #3 wants a Change Impact Log entry (PR body or docs/change-log/) and usually a feature flag for a change like this.${NC}"
        FOUND=1
      fi
    fi
  done <<< "$STAGED_SHARED"
fi
[ $FOUND -eq 0 ] && echo -e "${GREEN}  ✅ Clean${NC}"
[ $FOUND -eq 1 ] && echo -e "${YELLOW}  (warning-only — not blocking commit; the real gate is ci-guardrails.yml's Change Impact Log check on the PR)${NC}"

# 11. Known-fork one-sided-change reminder (warning only)
# docs/known-forks.md tracks file pairs that are intentionally duplicated
# (e.g. shared/components/CarMarker.tsx <-> driver-app/components/CarMarker.tsx).
# The 2026-09-12 ride-experience audit found fixes had been ported one-way by
# hand five times with nothing catching a missed port — one of those misses
# left a live-tested rider-facing bug unfixed for a full day. This can only
# nudge (a fork registry entry doesn't know whether a given change actually
# needs porting), never block.
echo "11/12 Checking known-fork registry (warning only)..."
FOUND=0
if [ -f docs/known-forks.md ]; then
  STAGED_FILES=${STAGED_FILES:-$(git diff --cached --name-only --diff-filter=ACM)}
  # Pull "File A | File B" pairs out of the registry table (skip header/separator rows).
  # shellcheck disable=SC2016  # backticks below are literal Markdown code-span delimiters, not command substitution
  PAIRS=$(grep -oE '^\| `[^`]+` \| `[^`]+` \|' docs/known-forks.md 2>/dev/null | sed -E 's/^\| `([^`]+)` \| `([^`]+)` \|/\1\t\2/')
  if [ -n "$PAIRS" ]; then
    while IFS=$'\t' read -r fileA fileB; do
      [ -z "$fileA" ] && continue
      hasA=$(printf '%s\n' "$STAGED_FILES" | grep -Fxc "$fileA")
      hasB=$(printf '%s\n' "$STAGED_FILES" | grep -Fxc "$fileB")
      if [ "$hasA" -gt 0 ] && [ "$hasB" -eq 0 ]; then
        echo -e "${YELLOW}  WARN — $fileA is staged but its tracked fork $fileB is not. Check docs/known-forks.md — does this change need porting to the sibling too?${NC}"
        FOUND=1
      elif [ "$hasB" -gt 0 ] && [ "$hasA" -eq 0 ]; then
        echo -e "${YELLOW}  WARN — $fileB is staged but its tracked fork $fileA is not. Check docs/known-forks.md — does this change need porting to the sibling too?${NC}"
        FOUND=1
      fi
    done <<< "$PAIRS"
  fi
else
  echo -e "${YELLOW}  ⚠ docs/known-forks.md not found — skipping${NC}"
fi
[ $FOUND -eq 0 ] && echo -e "${GREEN}  ✅ Clean${NC}"
[ $FOUND -eq 1 ] && echo -e "${YELLOW}  (warning-only — not blocking commit; use judgment on whether this specific change applies to the sibling)${NC}"

# 12. North-American phone numbers in added lines (blocking)
# 2026-09-25 (PR #5812): real driver phone numbers had been committed to
# ACTION_ITEMS.md, two audit docs and three backend test fixtures. Check 4
# only looks at log calls, so nothing caught them. This scans every ADDED
# line of every staged text file (docs included) for a NANP number in any
# common shape — +1 AAA EEE LLLL, (AAA) EEE-LLLL, AAA-EEE-LLLL, AAA.EEE.LLLL,
# AAAEEELLLL, +1AAAEEELLLL — and blocks unless it is in the reserved-for-
# fiction range 555-0100..555-0199 (any area code). Use that range for
# fixtures and examples. Area code and exchange must start 2-9 (NANP rule),
# which is what keeps Unix timestamps (1xxxxxxxxx) out; a match must not
# touch a letter, digit, "_" or a leading "." (hex/UUID/Stripe-ID fragments,
# longer numeric IDs, decimal fractions). Also allowed: a bare digit run
# right after "-" (URL IDs such as issuecomment-NNNNNNNNNN) and the int32/
# uint32 limits. Lockfiles and binary/asset files are skipped. Output shows
# only the last 4 digits — never echo the full number. Mirrored for CI as the
# `spinr-nanp-phone-number` rule in .gitleaks.toml; keep the two in step.
# No per-line bypass by design (a bypass marker is exactly what a real number
# would get pasted next to); a confirmed false positive uses --no-verify.
echo "12/12 Scanning added lines for real phone numbers..."
# shellcheck disable=SC2016  # awk program, $-fields are awk's, not the shell's
PHONE_AWK='
BEGIN {
  D = "[0-9]"; N = "[2-9]"
  PHONE_RE = "(\\+?1[ .-]?)?(\\(" N D D "\\)|" N D D ")[ .-]?" N D D "[ .-]?" D D D D
  file = "(unknown file)"; ln = 0; hdr = 0; skip = 0; hits = 0
}
/^diff --git / { hdr = 1; next }
hdr && /^\+\+\+ / {
  file = substr($0, 5); sub(/^b\//, "", file)
  skip = (file == "/dev/null" \
    || file ~ /(^|\/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|poetry\.lock|Pipfile\.lock|Cargo\.lock|Gemfile\.lock|composer\.lock)$/ \
    || file ~ /\.(lock|svg|png|jpe?g|gif|ico|webp|pdf|ttf|otf|woff2?|mp3|mp4|zip|gz|map)$/)
  next
}
/^@@ / {
  hdr = 0; h = $0
  sub(/^@@ -[0-9,]+ \+/, "", h); sub(/[, ].*$/, "", h); ln = h + 0
  next
}
hdr { next }
/^-/ { next }
/^\+/ { if (!skip) scan(substr($0, 2)); ln++; next }
{ ln++ }
function scan(line,    off, rest, s, e, cand, prev, nxt, nxt2, d) {
  off = 0; rest = line
  while (match(rest, PHONE_RE)) {
    s = off + RSTART; e = s + RLENGTH - 1
    cand = substr(line, s, RLENGTH)
    prev = (s > 1) ? substr(line, s - 1, 1) : ""
    nxt = substr(line, e + 1, 1); nxt2 = substr(line, e + 2, 1)
    off = s; rest = substr(line, s + 1)
    if (prev ~ /[0-9A-Za-z_.]/) continue
    if (nxt ~ /[0-9A-Za-z_]/) continue
    if (nxt == "." && nxt2 ~ /[0-9]/) continue
    if (prev == "-" && cand ~ /^[0-9]+$/) continue
    d = cand; gsub(/[^0-9]/, "", d)
    if (length(d) == 11) d = substr(d, 2)
    if (substr(d, 4, 3) == "555" && substr(d, 7, 2) == "01") continue
    if (d == "2147483647" || d == "4294967295") continue
    printf "%s:%s: ***-***-%s\n", file, ln, substr(d, 7, 4)
    hits++
    off = e; rest = substr(line, e + 1)
  }
}
'
# Fail closed: this check blocks, so a diff/awk failure (e.g. fork failure,
# awk missing) must not read as "no numbers found".
PHONE_SCAN_OK=1
PHONE_DIFF=$(git diff --cached -U0 --no-color --no-ext-diff) || PHONE_SCAN_OK=0
PHONE_HITS=$(printf '%s\n' "$PHONE_DIFF" | awk "$PHONE_AWK") || PHONE_SCAN_OK=0
if [ "$PHONE_SCAN_OK" -eq 0 ]; then
  echo -e "${RED}  BLOCKED — phone-number scan could not run (git diff or awk failed)${NC}"
  BLOCKED=1
elif [ -n "$PHONE_HITS" ]; then
  while IFS= read -r hit; do
    echo -e "${RED}  BLOCKED — phone number in added line: $hit${NC}"
  done <<< "$PHONE_HITS"
  echo -e "${RED}  Use the fictional range 555-0100..555-0199 (e.g. +1 306 555 0142) for fixtures and examples. Never commit a real person's number.${NC}"
  BLOCKED=1
else
  echo -e "${GREEN}  ✅ Clean${NC}"
fi

echo ""
if [ $BLOCKED -eq 1 ]; then
  echo -e "${RED}COMMIT BLOCKED — fix issues above${NC}"
  echo -e "${RED}Emergency bypass only: git commit --no-verify${NC}"
  exit 1
else
  echo -e "${GREEN}✅ All spinr pre-commit checks passed${NC}"
  exit 0
fi
