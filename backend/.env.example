# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT (required in production)
JWT_SECRET=your-strong-secret-key

# Environment (set to 'production' for prod)
ENV=development

# Trusted proxy hop count for X-Forwarded-For stripping.
# Set to the number of trusted reverse-proxy hops between the internet and this
# process.  Railway adds 1 hop (its load balancer), so the production default is 1.
# Set to 0 if running without a proxy (e.g. local development with direct access).
# Incorrect values allow clients to spoof their IP in X-Forwarded-For, which
# breaks rate-limiting and audit logging.
TRUSTED_PROXY_COUNT=1

# CORS — comma-separated list of allowed origins (R-P1-27)
# Production: restrict to known domains
# ALLOWED_ORIGINS=https://spinr.app,https://track.spinr.ca,https://admin-spinr.spinr.ca
# Note: track.spinr.ca and admin-spinr.spinr.ca are also in the always_allowed
# list in core/middleware.py so they work even if omitted here, but being
# explicit makes Railway / Render environment diffs easier to audit.
# Development default (set in core/config.py):
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Public tracking page — used when generating shareable trip links (SMS / push).
# Customer links are clean: {TRACKING_BASE_URL}/{token}; the tracking domain
# rewrites /{token} -> /track/{token} server-side. Use a dedicated subdomain
# that serves ONLY the tracking page (admin panel is blocked there).
# Production:  TRACKING_BASE_URL=https://track.spinr.ca
# Local dev:   use the full path form instead, e.g. http://localhost:3000/track
TRACKING_BASE_URL=https://track.spinr.ca

# Firebase
FIREBASE_RIDER_APP_ID=your-rider-firebase-app-id
FIREBASE_DRIVER_APP_ID=your-driver-firebase-app-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Route mapping (OSM-first, Google as guardrail)
# Self-hosted OSRM base URL for trip-end map-matching (billable road distance +
# road-snapped geometry). No trailing slash, no path — e.g.
# http://osrm.railway.internal:5000 (Railway private net) or
# https://osrm-xxxx.up.railway.app. When set, the completion road-snap and the
# route finalizer prefer OSRM /match; Google Roads is the fallback and a
# 1/3x-3x haversine sanity gate guards both. A DB override `osrm_url` in the
# app_settings table (admin-rotatable) takes precedence over this env value.
# Empty disables OSRM and falls back to Google Roads (then haversine).
OSRM_URL=
# Public OSRM used ONLY for LIGHT live calls (live-route line, ETA, single-point
# snap) when no self-hosted OSRM_URL is set. Trip-end map-matching over full GPS
# traces always requires an explicit OSRM_URL and never uses this. Set to "" to
# disable the public fallback entirely.
OSRM_FALLBACK_URL=https://router.project-osrm.org

# Observability — Sentry
# Error reporting (optional; the SDK only initialises when this is set).
SENTRY_DSN=
# Sentry Web API — powers the super-admin "Sentry Issues" viewer in the admin
# dashboard (/dashboard/sentry-logs). All optional: when the token, org, or all
# project slugs are unset the page renders a setup panel instead of querying,
# which is also the kill switch (unset the token to disable the feature with no
# redeploy). The token needs event:read plus event:write (write is used only to
# mark an issue resolved/ignored/reopened) plus project:read for the
# project-scoped issues endpoint.
#
# Use an INTERNAL INTEGRATION token (Settings -> Developer Settings -> Custom
# Integrations -> Internal Integration; set "Issue & Event: Read & Write" and
# "Project: Read"). NOT an Organization Auth Token: those have fixed CI-only
# scopes with no permission picker and cannot grant event:read/event:write.
# A personal auth token also works but is tied to one user and its scopes are
# not editable after creation. (Organization Auth Tokens are the right choice
# for the frontend's build-time SENTRY_AUTH_TOKEN source-map upload instead.)
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=
# Regional API host — must match the region your Sentry ORG was created in, or
# every read 404s. Spinr's org is US, for which the default below is correct.
# An EU org requires https://de.sentry.io.
SENTRY_API_BASE_URL=https://sentry.io
# The viewer separates surfaces in one of two mutually exclusive modes.
#
# TAG MODE (one Sentry project for everything) — set this to that project's
# slug and leave the four below empty. Surfaces are told apart by the `surface`
# tag every SDK sets at init, so the viewer's tabs filter with `surface:<name>`.
# Events with no surface tag stay visible under an "unknown" bucket.
SENTRY_PROJECT_ALL=
#
# PROJECT MODE (one Sentry project per surface) — set whichever apply; those
# define which surfaces appear in the viewer's filter. If ANY of these is set it
# wins and SENTRY_PROJECT_ALL is ignored, so moving from one shared project to
# four is an env change with no code change.
SENTRY_PROJECT_BACKEND=
SENTRY_PROJECT_RIDER=
SENTRY_PROJECT_DRIVER=
SENTRY_PROJECT_ADMIN=
