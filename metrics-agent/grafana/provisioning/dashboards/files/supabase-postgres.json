{
  "uid": "spinr-supabase",
  "title": "Supabase Postgres (production health)",
  "description": "Live health of the production Supabase Postgres (spinrmobileapp, ca-central-1), queried as the restricted grafana_monitor role: Postgres statistics views only, zero access to application table data. Values are point-in-time (Postgres keeps cumulative counters, not history), so these are stat/table panels rather than time series. See metrics-agent/README.md 'Supabase Postgres'.",
  "tags": [
    "spinr",
    "supabase",
    "database"
  ],
  "timezone": "America/Regina",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Connections",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Client connections",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(connections),0)::int as connections from monitoring.connection_summary()"
        }
      ],
      "description": "Client sessions only (via monitoring.connection_summary(), migration 489 -- counts/ages only, never query text)."
    },
